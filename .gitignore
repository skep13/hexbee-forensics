# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# HexBee runtime data (never commit evidence or databases)
dev-data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
evidence/
exports/

# Offline content is user-supplied, not part of the source
*.mbtiles
*.zim

# Local dev helper with machine-specific absolute paths
run_dev.cmd

# ESP-IDF build output
scout/firmware/build/
scout/firmware/sdkconfig

# PyInstaller / USB build output (the exe is rebuildable, ~7 MB, per-OS)
forager/usb/_build/
forager/usb/dist/
*.spec
# A responder's real Hive key must never be committed
forager/usb/forager.json

# Device configs hold Wi-Fi passwords and ingest keys. config.example.py is
# the tracked template; config.py is the real one and never belongs in a repo,
# least of all a public one.
scout/c3-stinger/config.py
scout/c3-scanner/config.py
device-configs/
*.hexbee-device.json

# Editor / OS
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
